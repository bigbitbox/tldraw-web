  "scripts": {
    "build": "vite build && esbuild server/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "dev": "tsx watch server/server.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit server/*.test.ts",
